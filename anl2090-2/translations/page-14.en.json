td class=\"m\">BRZ 1E</td><td style=\"white-space:nowrap\"></td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">14</td><td class=\"c\">926</td><td class=\"m\">CMPI 2,6</td><td style=\"white-space:nowrap\"></td><td>Pile 2?</td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">15</td><td class=\"c\">E1A</td><td class=\"m\">BRZ 1A</td><td style=\"white-space:nowrap\"></td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">16</td><td class=\"c\">815</td><td class=\"m\">CMP 1,5</td><td style=\"white-space:nowrap\"></td><td>Is the entry greater than pile 3?</td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">17</td><td class=\"c\">D0E</td><td class=\"m\">BRC 0E</td><td style=\"white-space:nowrap\"></td><td>Yes, then re-enter</td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">18</td><td class=\"c\">651</td><td class=\"m\">SUB 5,1</td><td style=\"white-space:nowrap\"></td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">19</td><td class=\"c\">C21</td><td class=\"m\">GOTO 21</td><td style=\"white-space:nowrap\">&bdquo;SPGEW&ldquo;</td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">1A</td><td class=\"c\">825</td><td class=\"m\">CMP 2,5</td><td style=\"white-space:nowrap\"></td><td>Entry greater than pile 2?</td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">1B</td><td class=\"c\">D0E</td><td class=\"m\">BRC 0E</td><td style=\"white-space:nowrap\"></td><td>Yes, then re-enter</td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">1C</td><td class=\"c\">652</td><td class=\"m\">SUB 5,2</td><td style=\"white-space:nowrap\"></td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">1D</td><td class=\"c\">C21</td><td class=\"m\">GOTO 21</td><td style=\"white-space:nowrap\">&bdquo;SPGEW&ldquo;</td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">1E</td><td class=\"c\">835</td><td class=\"m\">CMP 3,5</td><td style=\"white-space:nowrap\"></td><td>Entry greater than pile 1?</td></tr></table>"

\"></td><td class=\"a\">31</td><td class=\"c\">03E</td><td class=\"m\">MOV 3,E</td><td style=\"white-space:nowrap\"></td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">32</td><td class=\"c\">B66</td><td class=\"m\">CALL 66</td><td style=\"white-space:nowrap\">&bdquo;XOR&ldquo;</td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">33</td><td class=\"c\">8D1</td><td class=\"m\">CMP D,1</td><td style=\"white-space:nowrap\"></td><td></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">34</td><td class=\"c\">D4A</td><td class=\"m\">BRC 4A</td><td style=\"white-space:nowrap\">&bdquo;E3&ldquo;</td><td></td></tr><tr><td style=\"white-space:nowrap\">&bdquo;-1&ldquo;</td><td class=\"a\">35</td><td class=\"c\">901</td><td class=\"m\">CMPI 0,1</td><td style=\"white-space:nowrap\"></td><td rowspan=\"9\">&bdquo;Default move&ldquo;: take one away from one of the three piles</td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">36</td><td class=\"c\">E39</td><td class=\"m\">BRZ 39</td><td style=\"white-space:nowrap\"></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">37</td><td class=\"c\">711</td><td class=\"m\">SUBI 1,1</td><td style=\"white-space:nowrap\"></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">38</td><td class=\"c\">C3E</td><td class=\"m\">GOTO 3E</td><td style=\"white-space:nowrap\">&bdquo;CGEW&ldquo;</td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">39</td><td class=\"c\">902</td><td class=\"m\">CMPI 0,2</td><td style=\"white-space:nowrap\"></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">3A</td><td class=\"c\">E3D</td><td class=\"m\">BRZ 3D</td><td style=\"white-space:nowrap\"></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">3B</td><td class=\"c\">712</td><td class=\"m\">SUBI 1,2</td><td style=\"white-space:nowrap\"></td></tr><tr><td style=\"white-space:nowrap\"></td><td class=\"a\">3C</td><td class=\"c